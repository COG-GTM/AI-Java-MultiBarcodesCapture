      <trusted-artifacts>
         <!--
           JitPack (com.github.ltrudu.*) builds artifacts on demand from a personal GitHub
           account and mutable git tags, so those artifacts are pinned by SHA-256 below.
           Artifacts from every other group come from Google Maven / Maven Central / Zebra
           Artifactory and are trusted here; run gradlew with the write-verification-metadata
           option (see Gradle dependency verification docs) to pin them too.
         -->
         <trust group="^(?!com\.github\.ltrudu$).*" regex="true"/>
      </trusted-artifacts>
   </configuration>
